KAFKA_BOOTSTRAP_SERVERS=localhost:9092
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=market-data
MINIO_ANALYSIS_BUCKET=market-analysis
# Spark — leave unset for local[*] mode; set to cluster URL when using Docker
# SPARK_MASTER_URL=spark://spark-master:7077
# OHLCV ingest date override — use either, not both
# INGEST_DATE=2026-05-15   (absolute date, for backfill)
# LOOKBACK_DAYS=1          (days before today; default 0 = today)
